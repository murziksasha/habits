FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@11.14.0 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY packages/shared/package.json packages/shared/
COPY packages/content/package.json packages/content/
COPY packages/chess-core/package.json packages/chess-core/
COPY packages/db/package.json packages/db/
COPY apps/realtime/package.json apps/realtime/
RUN pnpm install --frozen-lockfile=false

FROM deps AS build
# Source only — node_modules stay from deps (must not be overwritten by host)
COPY packages ./packages
COPY apps/realtime ./apps/realtime
COPY turbo.json ./
RUN pnpm --filter @eduforge/shared build \
 && pnpm --filter @eduforge/content build \
 && pnpm --filter @eduforge/chess-core build \
 && pnpm --filter @eduforge/db build \
 && pnpm --filter @eduforge/realtime build

FROM base AS runner
ENV NODE_ENV=production
COPY --from=build /app /app
WORKDIR /app
EXPOSE 4001
CMD ["pnpm", "--filter", "@eduforge/realtime", "start"]
