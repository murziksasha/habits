{
  "name": "@eduforge/circuit-engine",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": {
    "./dist/process-pool.js": false
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "echo ok"
  },
  "dependencies": {
    "@eduforge/shared": "workspace:*",
    "eecircuit-engine": "1.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitest/coverage-v8": "3.2.7",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
