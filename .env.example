# Database
POSTGRES_USER=eduforge
POSTGRES_PASSWORD=eduforge
POSTGRES_DB=eduforge
DATABASE_URL=postgresql://eduforge:eduforge@localhost:5432/eduforge

# Redis
REDIS_URL=redis://localhost:6379

# Auth
AUTH_SECRET=change-me-to-a-long-random-string
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# Apps
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_REALTIME_URL=http://localhost:4001
API_PORT=4000
REALTIME_PORT=4001
WEB_PORT=3000
INTERNAL_API_URL=http://api:4000

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_YEARLY=price_xxx

# SMTP (optional — password reset / weekly report email; logs to console if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EduForge <noreply@eduforge.local>

# SpaceXAI / xAI tutor (optional — local rule-based tutor if unset)
# https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-4.5

# Web Push (VAPID) — generate: npx web-push generate-vapid-keys
# If unset, API generates ephemeral keys (clients must re-subscribe after restart)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@eduforge.local

# Cron / reminders (optional)
CRON_SECRET=

# App
NODE_ENV=development
LOCALE=uk
