# Database
POSTGRES_USER=eduforge
POSTGRES_PASSWORD=eduforge
POSTGRES_DB=eduforge
# Host ports if 5432/6379 are taken: POSTGRES_PORT=5433 REDIS_PORT=6380
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://eduforge:eduforge@localhost:5432/eduforge
# Undo file for Admin → Backup. Outside Postgres. Default: apps/api/data/backups
# BACKUP_DIR=/data/backups
# When POSTGRES_PORT=5433 use: postgresql://eduforge:eduforge@localhost:5433/eduforge

# Redis
REDIS_URL=redis://localhost:6379

# Auth — REQUIRED in production: generate with `openssl rand -hex 32`
# Never use placeholders (superSecret123 / change-me-to-a-long-random-string) in production.
# The API refuses to boot in NODE_ENV=production if AUTH_SECRET is missing, short, or a known default.
AUTH_SECRET=generate-a-strong-random-secret-min-32-chars
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
# WEB_ORIGIN must match browser origin (CORS + CSRF)
WEB_ORIGIN=http://localhost:3000
# Production: set FEATURE_STRICT_CSRF=0 only if edge handles CSRF
# FEATURE_STRICT_CSRF=1
# Email verification (default on). Hard gate login: FEATURE_REQUIRE_EMAIL_VERIFY=1
# FEATURE_EMAIL_VERIFY=1
# Issue Bearer tokens in JSON (default on non-prod; web uses httpOnly cookie only)
# ISSUE_BEARER_TOKENS=0
# Judge: production defaults OFF unless JUDGE_MODE=docker
# JUDGE_MODE=local
# JUDGE_MODE=docker
# JUDGE_ALLOW_LOCAL=1
# JUDGE_DOCKER_FALLBACK_LOCAL=1
# JUDGE_ALLOW_BASH_LOCAL=1

# Apps
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_REALTIME_URL=http://localhost:4001
API_PORT=4000
REALTIME_PORT=4001
WEB_PORT=3000
INTERNAL_API_URL=http://api:4000

# C++ playground / code_run: auto | jscpp | wasm | mock
# auto = JSCPP in browser, mock on SSR/CI; mock = lightweight sim only
NEXT_PUBLIC_CPP_RUNNER=auto

# Node Studio (WebContainers) — set 1 to enable /studio/node
# Needs Chrome + COOP/COEP on that route (configured in next.config)
# Commercial SaaS may need a StackBlitz WebContainers license
NEXT_PUBLIC_WEBCONTAINERS=1

# SMTP (optional — password reset / weekly report email; logs to console if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EduForge <noreply@eduforge.local>

# SpaceXAI / xAI tutor (optional — local rule-based tutor if unset)
# https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-4.7

# OpenRouter (optional — one key for many models, OpenAI-compatible)
# https://openrouter.ai/settings/keys
# Base URL: https://openrouter.ai/api/v1
# Model ids are author/slug, for example google/gemma-4-26b-a4b-it:free
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# Optional ranking headers (HTTP-Referer, X-Title)
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_APP_NAME=EduForge

# Gemini API (optional — Google’s model API, not the Antigravity app)
# Antigravity is Google’s coding agent. It is not a separate HTTP API.
# Its managed agent on the Gemini API is the model id antigravity-preview-09-2026.
# Keys: https://aistudio.google.com/apikey
# Endpoint: https://generativelanguage.googleapis.com
# Libraries read GEMINI_API_KEY, or GOOGLE_API_KEY if that one is set instead.
# Not the same as GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET (those are login only).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Flagship: gemini-4-argon. Antigravity agent: antigravity-preview-09-2026

# Web Push (VAPID) — generate: npx web-push generate-vapid-keys
# If unset, API generates ephemeral keys (clients must re-subscribe after restart)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@eduforge.local

# Cron / reminders — REQUIRED in production for /parents/digest/run, homework cron, judge drain
# Generate: openssl rand -hex 24
CRON_SECRET=

# Seed demo admin account is blocked when NODE_ENV=production unless:
# ALLOW_PROD_SEED=1

# Google OAuth (optional — login/register)
# Redirect URI must match exactly (default API callback):
#   http://localhost:4000/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/auth/oauth/google/callback
# API_PUBLIC_URL=http://localhost:4000
# ALLOW_DEV_OAUTH=1  # POST /auth/oauth/google/dev-login when keys missing

# App
NODE_ENV=development
LOCALE=uk
